# Copy to .env (git-ignored) and fill in the blanks. config.py loads .env with
# override=True, so these values beat anything exported in your shell.
# Point everything at the Supabase CLI local stack (`supabase start`) and the
# TEST Discord bot, never production. See docs/test-discord-server.md.

# Token of the TEST bot application (never the production token). The bot refuses to start without it.
DISCORD_TOKEN=

# Needed to start; Crudobot receipts and Chismebot summaries call OpenAI.
OPENAI_API_KEY=

# API URL printed by `supabase start` (port is [api] port in supabase/config.toml). Never the hosted project.
SUPABASE_URL=http://127.0.0.1:54321

# SERVICE_ROLE_KEY from `supabase status -o env`.
SUPABASE_SERVICE_ROLE_KEY=

# Legacy alias read only by db/database.py and vueltabot; leave unset.
# SUPABASE_KEY=

# Legacy SQLite path for Guardabot (git-ignored *.db).
GUARDABOT_DB=guardabot.db

# Dashboard push endpoint; empty means every time block replies "Saved, but dashboard push failed".
DATA_SERVICE_URL=

# Test-server channel id for Vueltabot trips; must be an integer, 0 = not configured (empty crashes vueltabot's load).
TRANSPORTATION_CHANNEL_ID=0

# Metichebot morning audio link; keep commented out, an empty value would replace the YouTube default with "".
# DANIEL_MORNING_AUDIO_URL=

# Crudobot receipt model; keep commented out, an empty value would replace the default with "".
# CRUDOBOT_RECEIPT_MODEL=gpt-5-mini
